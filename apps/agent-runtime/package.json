{
  "name": "@piano/agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "checkpoint:setup": "tsx src/checkpoint/setup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@langchain/openai": "1.6.2",
    "@piano/assistant-protocol": "1.0.0",
    "@piano/generated-core-client": "1.0.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
