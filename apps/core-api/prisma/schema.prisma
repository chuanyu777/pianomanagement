generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PreviewRiskLevel {
  L1
  L2
}

enum PreviewStatus {
  PENDING
  EXECUTED
  CANCELLED
  EXPIRED
  STALE
}

enum UserRole {
  OWNER
  TEACHER
}

enum PaymentChannel {
  CASH
  WECHAT
  ALIPAY
  BANK_CARD
  OTHER
}

enum LedgerEntryKind {
  PAYMENT
  GIFT
  PAYMENT_REVERSAL
  GIFT_REVERSAL
  LESSON_CONSUMPTION
  LESSON_CONSUMPTION_REVERSAL
  LESSON_CONSUMPTION_CORRECTION
  REFUND_PAID
  REFUND_GIFT_CLEARING
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  UNPAID
  PAID
}

enum ManualTransactionKind {
  INCOME
  EXPENSE
}

enum ManualIncomeCategory {
  BOOK_SALE
  INSTRUMENT_SALE
  EXTERNAL_COOPERATION
  OTHER_INCOME
}

enum ManualExpenseCategory {
  RENT_PROPERTY
  UTILITIES_NETWORK
  MARKETING
  OFFICE_SUPPLIES
  MAINTENANCE
  BOOK_PURCHASE_COST
  INSTRUMENT_PURCHASE_COST
  EXTERNAL_COOPERATION_COST
  OTHER_EXPENSE
}

model User {
  id               String          @id @default(uuid())
  username         String          @unique
  passwordHash     String
  role             UserRole
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teacher          Teacher?
  payments         PaymentRecord[]
  gifts            GiftRecord[]
  ledgerEntries    LedgerEntry[]
  completedLessons Lesson[]        @relation("LessonCompletedBy")
  refundsCreated   RefundRecord[]  @relation("RefundCreatedBy")
  payrollsGenerated Payroll[]      @relation("PayrollGeneratedBy")
  payrollsPaid      Payroll[]      @relation("PayrollPaidBy")
  manualTransactions ManualTransaction[]
  closedPeriods      ClosedPeriod[] @relation("PeriodClosedBy")
  reopenedPeriods    ClosedPeriod[] @relation("PeriodReopenedBy")
}

model Teacher {
  id                    String    @id @default(uuid())
  userId                String?   @unique
  name                  String
  isActive              Boolean   @default(true)
  defaultBaseSalary     Decimal   @default(0) @db.Decimal(14, 2)
  defaultCommissionRate Decimal   @default(0) @db.Decimal(7, 4)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessons               Lesson[]
  payrolls              Payroll[]
}

model Student {
  id             String                 @id @default(uuid())
  name           String
  phone          String?
  notes          String?
  withdrawnAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  courseAccounts StudentCourseAccount[]
  refunds        RefundRecord[]
}

model Course {
  id                     String                 @id @default(uuid())
  name                   String
  defaultUnitPrice       Decimal                @db.Decimal(14, 2)
  defaultDurationMinutes Int
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  studentAccounts        StudentCourseAccount[]
}

model StudentCourseAccount {
  id                 String          @id @default(uuid())
  studentId          String
  courseId           String
  currentUnitPrice   Decimal         @db.Decimal(14, 2)
  openingPaidBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingGiftBalance Decimal         @default(0) @db.Decimal(14, 2)
  version            Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  student            Student         @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course             Course          @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments           PaymentRecord[]
  gifts              GiftRecord[]
  ledgerEntries      LedgerEntry[]
  lessons            Lesson[]
  refundDetails      RefundDetail[]

  @@unique([studentId, courseId])
  @@index([courseId])
}

model PaymentRecord {
  id          String               @id @default(uuid())
  accountId   String
  amount      Decimal              @db.Decimal(14, 2)
  occurredAt  DateTime
  channel     PaymentChannel
  note        String?
  createdById String
  createdAt   DateTime             @default(now())
  account     StudentCourseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerEntry LedgerEntry?

  @@index([accountId, occurredAt])
}

model GiftRecord {
  id          String               @id @default(uuid())
  accountId   String
  amount      Decimal              @db.Decimal(14, 2)
  occurredAt  DateTime
  note        String?
  createdById String
  createdAt   DateTime             @default(now())
  account     StudentCourseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerEntry LedgerEntry?

  @@index([accountId, occurredAt])
}

model LedgerEntry {
  id              String               @id @default(uuid())
  accountId       String
  kind            LedgerEntryKind
  paidDelta       Decimal              @default(0) @db.Decimal(14, 2)
  giftDelta       Decimal              @default(0) @db.Decimal(14, 2)
  occurredAt      DateTime
  note            String?
  createdById     String
  commandId       String               @unique
  paymentId       String?              @unique
  giftId          String?              @unique
  lessonId        String?              @unique
  refundDetailId  String?
  reversesEntryId String?              @unique
  correctsEntryId String?              @unique
  createdAt       DateTime             @default(now())
  account         StudentCourseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment         PaymentRecord?       @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gift            GiftRecord?          @relation(fields: [giftId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson          Lesson?              @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refundDetail    RefundDetail?        @relation(fields: [refundDetailId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversesEntry   LedgerEntry?         @relation("LedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedBy      LedgerEntry?         @relation("LedgerEntryReversal")
  correctsEntry   LedgerEntry?         @relation("LedgerEntryCorrection", fields: [correctsEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctedBy     LedgerEntry?         @relation("LedgerEntryCorrection")

  @@index([accountId, occurredAt, id])
  @@index([createdById, createdAt])
  @@index([refundDetailId])
}

model Lesson {
  id                String               @id @default(uuid())
  accountId         String
  teacherId         String
  startsAt          DateTime
  endsAt            DateTime
  status            LessonStatus         @default(SCHEDULED)
  note              String?
  unitPriceSnapshot Decimal?             @db.Decimal(14, 2)
  completedAt       DateTime?
  completedById     String?
  version           Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  account           StudentCourseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher           Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedBy       User?                @relation("LessonCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumptionEntry  LedgerEntry?

  @@index([accountId, startsAt])
  @@index([teacherId, startsAt])
}

model RefundRecord {
  id                 String         @id @default(uuid())
  studentId          String         @unique
  totalPaidRefund    Decimal        @db.Decimal(14, 2)
  feeAmount          Decimal        @db.Decimal(14, 2)
  feePercentage      Decimal        @db.Decimal(7, 2)
  actualRefundAmount Decimal        @db.Decimal(14, 2)
  channel            PaymentChannel
  occurredAt         DateTime
  note               String?
  createdById        String
  createdAt          DateTime       @default(now())
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User           @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  details            RefundDetail[]

  @@index([occurredAt])
}

model RefundDetail {
  id                 String               @id @default(uuid())
  refundId           String
  accountId          String
  paidBalanceBefore  Decimal              @db.Decimal(14, 2)
  giftBalanceBefore  Decimal              @db.Decimal(14, 2)
  paidRefundAmount   Decimal              @db.Decimal(14, 2)
  giftClearingAmount Decimal              @db.Decimal(14, 2)
  refund             RefundRecord         @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account            StudentCourseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerEntries      LedgerEntry[]

  @@unique([refundId, accountId])
  @@index([accountId])
}

model Payroll {
  id               String         @id @default(uuid())
  teacherId        String
  periodStart      DateTime
  courseRevenue    Decimal        @db.Decimal(14, 2)
  baseSalary       Decimal        @db.Decimal(14, 2)
  commissionRate   Decimal        @db.Decimal(7, 4)
  commissionAmount Decimal        @db.Decimal(14, 2)
  bonusAmount      Decimal        @default(0) @db.Decimal(14, 2)
  bonusNote        String?
  deductionAmount  Decimal        @default(0) @db.Decimal(14, 2)
  deductionNote    String?
  grossSalary      Decimal        @db.Decimal(14, 2)
  netSalary        Decimal        @db.Decimal(14, 2)
  status           PayrollStatus  @default(UNPAID)
  paidAt           DateTime?
  paymentChannel   PaymentChannel?
  paymentNote      String?
  generatedById    String
  paidById         String?
  version          Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generatedBy      User           @relation("PayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paidBy           User?          @relation("PayrollPaidBy", fields: [paidById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teacherId, periodStart])
  @@index([periodStart, status])
}

model ManualTransaction {
  id              String                @id @default(uuid())
  kind            ManualTransactionKind
  incomeCategory  ManualIncomeCategory?
  expenseCategory ManualExpenseCategory?
  amount          Decimal               @db.Decimal(14, 2)
  channel         PaymentChannel
  occurredAt      DateTime
  note            String?
  createdById     String
  createdAt       DateTime              @default(now())
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kind, occurredAt])
}

model ClosedPeriod {
  id           String    @id @default(uuid())
  periodStart  DateTime  @unique
  closedAt     DateTime  @default(now())
  closedById   String
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  closedBy     User      @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reopenedBy   User?     @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model ActionPreview {
  id                    String           @id @default(uuid())
  actorUserId           String
  actionType            String
  schemaVersion         String
  riskLevel             PreviewRiskLevel
  normalizedCommandJson Json
  displayJson           Json
  resourceVersionsJson  Json
  idempotencyKey        String           @unique
  status                PreviewStatus    @default(PENDING)
  expiresAt             DateTime
  executedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([actorUserId, status, expiresAt])
}

model BusinessAuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?
  runId        String?
  previewId    String?
  eventType    String
  resourceType String?
  resourceId   String?
  requestId    String
  detailJson   Json
  createdAt    DateTime @default(now())

  @@index([runId, createdAt])
  @@index([previewId, createdAt])
}
