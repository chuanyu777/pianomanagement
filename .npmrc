# 国内镜像，装依赖快很多。换网络环境就改这一行。
registry=https://registry.npmmirror.com

# 必须开：npm 10 在解 vitest 的 peer 集时会递归崩（Cannot read properties of null
# reading 'edgesOut'）。关掉 peer 求解就能装。副作用是 peer 冲突不再报错，
# 所以升级依赖后要跑一遍 build + test 来兜底。
legacy-peer-deps=true

# 新增依赖一律钉精确版本，避免版本漂移
save-exact=true
fund=false
audit=false
