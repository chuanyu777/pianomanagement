{
  "name": "piano-management",
  "version": "1.0.0",
  "private": true,
  "description": "AI Native 琴行经营管理系统",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:core": "npm run start:dev -w @piano/core-api",
    "dev:agent": "npm run start:dev -w @piano/agent-runtime",
    "dev:web": "npm run dev -w @piano/web",
    "db:up": "docker compose up -d core-db agent-db",
    "db:down": "docker compose down",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "db:generate": "npm run db:generate -w @piano/core-api",
    "db:migrate": "npm run db:migrate -w @piano/core-api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @piano/core-api",
    "agent:db:migrate": "npm run db:migrate -w @piano/agent-runtime",
    "agent:checkpoint:setup": "npm run checkpoint:setup -w @piano/agent-runtime",
    "test:agent:integration": "npm test -w @piano/agent-runtime"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.88.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "fsevents": false
  }
}
